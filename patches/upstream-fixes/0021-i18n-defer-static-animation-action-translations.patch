+    const KLocalizedString dropFramesActionName = ki18n("Drop Frames");
+
+    const KLocalizedString newLayerActionName = ki18n("New Layer");
+    const KLocalizedString pinExistingLayerActionName = ki18n("Pin Existing Layer");
