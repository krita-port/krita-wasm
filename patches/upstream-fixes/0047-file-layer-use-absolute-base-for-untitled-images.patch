Subject: [PATCH] Resolve an untitled image's file-layer base to an absolute directory

QFileInfo of an empty document path returns an empty absolutePath. A relative file-layer name then remains relative when saved in the KRA, even after the document has acquired a different save directory. Resolve absoluteDir().absolutePath() instead so the layer retains the actual source location and the exporter can rebase its link correctly. This also affects desktop builds.

Related upstream discussion: https://bugs.kde.org/show_bug.cgi?id=413594
The official issue comments document relative file-layer semantics; they do not report this untitled conversion defect. Searches found no corresponding report for this path calculation.

diff --git a/libs/ui/kis_layer_manager.cc b/libs/ui/kis_layer_manager.cc
--- a/libs/ui/kis_layer_manager.cc
+++ b/libs/ui/kis_layer_manager.cc
@@ -307,7 +307,7 @@
         }
     }
     else if (fileLayer && !multipleLayersSelected){
-        QString basePath = QFileInfo(m_view->document()->path()).absolutePath();
+        QString basePath = QFileInfo(m_view->document()->path()).absoluteDir().absolutePath();
         QString fileNameOld = fileLayer->fileName();
         KisFileLayer::ScalingMethod scalingMethodOld = fileLayer->scalingMethod();
         QString scalingFilterOld = fileLayer->scalingFilter();
@@ -610,7 +610,7 @@
 
         qWarning() << "Converting layer to file layer. path:"<< path << "gave errors" << doc->errorMessage();
     } else {
-        QString basePath = QFileInfo(m_view->document()->path()).absolutePath();
+        QString basePath = QFileInfo(m_view->document()->path()).absoluteDir().absolutePath();
         QString relativePath = QDir(basePath).relativeFilePath(path);
         KisFileLayer *fileLayer = new KisFileLayer(image, basePath, relativePath, KisFileLayer::None, "Bicubic", source->name(), OPACITY_OPAQUE_U8);
         fileLayer->setX(bounds.x());
@@ -1030,7 +1030,7 @@
 {
     QString basePath;
     QString path = m_view->document()->path();
-    basePath = QFileInfo(path).absolutePath();
+    basePath = QFileInfo(path).absoluteDir().absolutePath();
     KisImageWSP image = m_view->image();
 
     KisDlgFileLayer dlg(basePath, image->nextLayerName(i18n("File Layer")), m_view->mainWindow());
