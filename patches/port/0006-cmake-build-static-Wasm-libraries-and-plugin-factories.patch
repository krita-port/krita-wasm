diff --git a/cmake/modules/KritaWasmTargets.cmake b/cmake/modules/KritaWasmTargets.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/modules/KritaWasmTargets.cmake
@@ -0,0 +1,61 @@
+# Krita's modules become static Qt plugins in the browser. Factories are
+# private to each module, so their exported Qt plugin names must be unique.
+function(krita_wasm_add_library)
+    set(args ${ARGV})
+    list(GET args 0 target)
+    list(FIND args MODULE module_index)
+    if(module_index GREATER -1)
+        list(REMOVE_AT args ${module_index})
+        list(REMOVE_AT args 0)
+        set(factories)
+        foreach(source IN LISTS args)
+            get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
+            if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
+                file(READ "${path}" contents)
+                string(REGEX MATCHALL "K_PLUGIN_FACTORY_WITH_JSON[ \t\r\n]*\\([ \t\r\n]*[A-Za-z_][A-Za-z0-9_]*" declarations "${contents}")
+                foreach(declaration IN LISTS declarations)
+                    string(REGEX REPLACE ".*\\([ \t\r\n]*" "" factory "${declaration}")
+                    list(APPEND factories "${factory}")
+                endforeach()
+            endif()
+        endforeach()
+        list(REMOVE_DUPLICATES factories)
+        list(LENGTH factories count)
+        if(NOT count EQUAL 1)
+            message(FATAL_ERROR "Static Krita plugin ${target}: expected one KDE factory, got ${factories}")
+        endif()
+        list(GET factories 0 original_factory)
+        string(MAKE_C_IDENTIFIER "KritaWasm_${target}_Factory" factory)
+        add_library(${target} STATIC ${args})
+        target_compile_definitions(${target} PRIVATE QT_STATICPLUGIN "${original_factory}=${factory}")
+        set_property(TARGET ${target} PROPERTY KRITA_WASM_FACTORY "${factory}")
+        # Test-only modules are not application plugins.
+        if(CMAKE_CURRENT_SOURCE_DIR MATCHES "[/\\]plugins([/\\]|$)")
+            set_property(GLOBAL APPEND PROPERTY KRITA_WASM_PLUGIN_TARGETS ${target})
+        endif()
+    else()
+        list(FIND args SHARED shared_index)
+        if(shared_index GREATER -1)
+            list(REMOVE_AT args ${shared_index})
+            list(INSERT args ${shared_index} STATIC)
+        endif()
+        add_library(${args})
+    endif()
+endfunction()
+
+# Keep imports in an executable object so archive dead stripping cannot discard
+# plugin factories. Use each target's actual, unique class name.
+function(krita_wasm_import_plugins target)
+    set(imports "#include <QPluginLoader>\n")
+    foreach(plugin IN LISTS ARGN)
+        get_target_property(factory ${plugin} KRITA_WASM_FACTORY)
+        if(NOT factory)
+            message(FATAL_ERROR "Missing static factory for ${plugin}")
+        endif()
+        string(APPEND imports "Q_IMPORT_PLUGIN(${factory})\n")
+    endforeach()
+    set(source "${CMAKE_CURRENT_BINARY_DIR}/${target}_wasm_plugins.cpp")
+    file(GENERATE OUTPUT "${source}" CONTENT "${imports}")
+    target_sources(${target} PRIVATE "${source}")
+    target_link_libraries(${target} PRIVATE ${ARGN})
+endfunction()
diff --git a/krita/CMakeLists.txt b/krita/CMakeLists.txt
--- a/krita/CMakeLists.txt
+++ b/krita/CMakeLists.txt
@@ -206,6 +206,13 @@
     # Build the main implementation into a DLL to be called by a stub EXE.
     kis_add_library(krita SHARED ${krita_SRCS})
     set_target_properties(krita PROPERTIES PREFIX "")
+elseif(EMSCRIPTEN)
+    qt_add_executable(krita ${krita_SRCS})
+    get_property(wasm_plugins GLOBAL PROPERTY KRITA_WASM_PLUGIN_TARGETS)
+    target_link_libraries(krita PRIVATE kritaqmlcomponents)
+    krita_wasm_import_plugins(krita ${wasm_plugins})
+    set_target_properties(krita PROPERTIES QT_WASM_EXPORT_NAME kritaWasm QT_WASM_PTHREAD_POOL_SIZE 4)
+    target_link_options(krita PRIVATE -sDISABLE_EXCEPTION_CATCHING=0 -sASSERTIONS=1)
 else()
     add_executable(krita ${krita_SRCS})
 endif()
@@ -238,7 +245,7 @@
