     }
     else {
         dbgLocale << "Qt UI languages:" << QLocale::system().uiLanguages() << qgetenv("LANG");
@@ -663,6 +683,9 @@
 
     // first create the application so we can create a pixmap
     KisApplication app(key, argc, argv);
