         const QString &firstLanguage = languageList.constFirst();
         if (ALLOW_FALLBACK_LANGUAGES) {
             KLocalizedString::setLanguages(languageList);
@@ -555,7 +564,14 @@
         }
 
         // And override Qt's locale, too
+#ifdef Q_OS_WASM
