diff --git a/cmake/modules/KritaWasmStaticDependencies.cmake b/cmake/modules/KritaWasmStaticDependencies.cmake
--- a/cmake/modules/KritaWasmStaticDependencies.cmake
+++ b/cmake/modules/KritaWasmStaticDependencies.cmake
@@ -1,5 +1,22 @@
 # Preserve the complete archive link interface of the browser font stack.
 function(krita_link_wasm_static_dependencies)
+    if(NOT EXISTS "${KRITA_I18N_DIR}/target/lib/libKF6I18n.a")
+        message(FATAL_ERROR "Set KRITA_I18N_DIR to the verified prebuilt i18n supplement")
+    endif()
+    # Retain the frozen base SDK, replacing only its ABI-compatible KI18n
+    # archive with the GNU-gettext/Transcript build from the supplement.
+    get_target_property(i18n_configs KF6::I18n IMPORTED_CONFIGURATIONS)
+    foreach(config IN LISTS i18n_configs)
+        string(TOUPPER "${config}" upper_config)
+        set_property(TARGET KF6::I18n PROPERTY IMPORTED_LOCATION_${upper_config}
+            "${KRITA_I18N_DIR}/target/lib/libKF6I18n.a")
+    endforeach()
+    set_property(TARGET KF6::I18n PROPERTY IMPORTED_LOCATION
+        "${KRITA_I18N_DIR}/target/lib/libKF6I18n.a")
+    target_link_libraries(KF6::I18n INTERFACE
+        "${KRITA_I18N_DIR}/target/lib/libktranscript.a"
+        "${KRITA_I18N_DIR}/target/lib/libintl.a"
+        "$<LINK_ONLY:Qt6::Qml>")
     find_package(PkgConfig REQUIRED)
     list(APPEND PKG_CONFIG_ARGN --static)
     pkg_check_modules(KRITA_WASM_FONT_STACK REQUIRED IMPORTED_TARGET GLOBAL fontconfig harfbuzz freetype2)
diff --git a/libs/widgetutils/xmlgui/kswitchlanguagedialog_p.cpp b/libs/widgetutils/xmlgui/kswitchlanguagedialog_p.cpp
--- a/libs/widgetutils/xmlgui/kswitchlanguagedialog_p.cpp
+++ b/libs/widgetutils/xmlgui/kswitchlanguagedialog_p.cpp
@@ -55,10 +55,18 @@
 
 static QByteArray getApplicationSpecificLanguage(const QByteArray &defaultCode = QByteArray())
 {
+#ifdef Q_OS_WASM
+    Q_UNUSED(defaultCode);
+    QStringList languages = QString::fromUtf8(qgetenv("KRITA_UI_LANGUAGES")).split(QStringLiteral(":"), Qt::SkipEmptyParts);
+    for (QString &entry : languages)
+        if (entry == QStringLiteral("en")) entry = QStringLiteral("en_US");
+    return languages.join(QStringLiteral(":")).toUtf8();
+#else
     QSettingsPtr settings = localeOverridesSettings();
     settings->beginGroup(QStringLiteral("Language"));
     //qDebug() << "our language" << settings->value(qAppName(), defaultCode).toByteArray();
     return settings->value(qAppName(), defaultCode).toByteArray();
+#endif
 }
 
 static void setApplicationSpecificLanguage(const QByteArray &languageCode)
@@ -94,6 +102,10 @@
 
 Q_COREAPP_STARTUP_FUNCTION(initializeLanguages)
 
+#ifdef Q_OS_WASM
+extern void kritaWasmRequestLanguages(const QStringList &languages);
+#endif
+
 namespace KDEPrivate
 {
 
@@ -279,11 +291,15 @@
     if (d->applicationLanguageList() != languages) {
         QString languageString = languages.join(QLatin1Char(':'));
         //list is different from defaults or saved languages list
+#ifdef Q_OS_WASM
+        kritaWasmRequestLanguages(languages);
+#else
         setApplicationSpecificLanguage(languageString.toLatin1());
 
         QMessageBox::information(this,
                                  i18nc("@title:window:", "Application Language Changed"), //caption
                                  i18n("The language for this application has been changed. The change will take effect the next time the application is started."));
+#endif
     }
 
     accept();
@@ -291,7 +307,11 @@
 
 void KisKSwitchLanguageDialog::slotDefault()
 {
+#ifdef Q_OS_WASM
+    kritaWasmRequestLanguages(QStringList());
+#else
     setApplicationSpecificLanguage(QByteArray());
+#endif
     accept();
 }
 
@@ -316,6 +336,19 @@
 
 void KisKSwitchLanguageDialogPrivate::fillApplicationLanguages(KLanguageButton *button)
 {
+#ifdef Q_OS_WASM
+    QStringList languages = KLocalizedString::availableApplicationTranslations().values();
+    languages.sort();
+    for (const QString &code : languages) {
+        QString localeName = code;
+        localeName.replace(QStringLiteral("@cyrillic"), QStringLiteral("_Cyrl"));
+        localeName.replace(QStringLiteral("@latin"), QStringLiteral("_Latn"));
+        const QLocale locale(localeName);
+        QString name = locale.nativeLanguageName();
+        if (name.isEmpty() || locale.language() == QLocale::C) name = code;
+        button->insertLanguage(code, name + QStringLiteral(" (") + code + QLatin1Char(')'));
+    }
+#else
     QLocale defaultLocale;
     QLocale cLocale(QLocale::C);
     QLocale::setDefault(cLocale);
@@ -369,6 +402,7 @@
     }
 
     QLocale::setDefault(defaultLocale);
+#endif
 }
 
 QStringList KisKSwitchLanguageDialogPrivate::applicationLanguageList()
