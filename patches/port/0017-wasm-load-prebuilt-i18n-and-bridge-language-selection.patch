         QLocale::setDefault(locale);
 #ifdef Q_OS_MAC
         // prevents python >=3.7 nl_langinfo(CODESET) fail bug 417312.
@@ -564,12 +580,16 @@
         qputenv("LANG", locale.name().toLocal8Bit());
 #endif
 
+#ifdef Q_OS_WASM
+        rightToLeft = locale.textDirection() == Qt::RightToLeft;
