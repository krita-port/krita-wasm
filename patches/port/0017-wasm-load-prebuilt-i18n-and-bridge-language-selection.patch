@@ -547,6 +552,10 @@
     bool rightToLeft = false;
     if (!language.isEmpty()) {
         QStringList languageList = language.split(QStringLiteral(":"));
+#ifdef Q_OS_WASM
+        for (QString &entry : languageList)
