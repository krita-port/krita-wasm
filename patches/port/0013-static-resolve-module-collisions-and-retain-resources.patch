Subject: [PATCH] Resolve static module collisions and retain Qt resources

Factor shared QObject converters once, distinguish the private artistic
selector class, make header-defined helpers inline, and anchor archive
resources. Give the two different defaulttools resource collections unique
internal names without changing their runtime paths.

diff --git a/plugins/dockers/artisticcolorselector/CMakeLists.txt b/plugins/dockers/artisticcolorselector/CMakeLists.txt
--- a/plugins/dockers/artisticcolorselector/CMakeLists.txt
+++ b/plugins/dockers/artisticcolorselector/CMakeLists.txt
@@ -14,3 +14,8 @@
 kis_add_library(kritaartisticcolorselector MODULE ${kritaartisticcolorselector_SOURCES})
 target_link_libraries(kritaartisticcolorselector kritaui)
 install(TARGETS kritaartisticcolorselector DESTINATION ${KRITA_PLUGIN_INSTALL_DIR})
+
+if(EMSCRIPTEN)
+    # The advanced selector has an unrelated private class with this name.
+    target_compile_definitions(kritaartisticcolorselector PRIVATE KisColorSelector=KisArtisticColorSelector)
+endif()
diff --git a/plugins/impex/ora/CMakeLists.txt b/plugins/impex/ora/CMakeLists.txt
--- a/plugins/impex/ora/CMakeLists.txt
+++ b/plugins/impex/ora/CMakeLists.txt
@@ -31,3 +31,13 @@
 install(TARGETS kritaoraexport  DESTINATION ${KRITA_PLUGIN_INSTALL_DIR})
 
 install(FILES krita_ora.desktop DESTINATION ${KDE_INSTALL_APPDIR})
+
+if(EMSCRIPTEN)
+    # Shared QObject implementation must have exactly one moc in the program.
+    kis_add_library(kritaoraconverter STATIC ${libkritaconverter_LIB_SRCS})
+    target_link_libraries(kritaoraconverter PUBLIC kritaui)
+    set_property(TARGET kritaoraimport PROPERTY SOURCES ora_import.cc)
+    set_property(TARGET kritaoraexport PROPERTY SOURCES ora_export.cc)
+    target_link_libraries(kritaoraimport kritaoraconverter)
+    target_link_libraries(kritaoraexport kritaoraconverter)
+endif()
