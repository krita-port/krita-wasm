diff --git a/cmake/modules/KritaWasmTargets.cmake b/cmake/modules/KritaWasmTargets.cmake
--- a/cmake/modules/KritaWasmTargets.cmake
+++ b/cmake/modules/KritaWasmTargets.cmake
@@ -42,6 +42,22 @@
         endif()
         add_library(${args})
     endif()
+    # Classic qt_add_resources output is just another archive member. Anchor
+    # its initializer explicitly, as well as the plugin factory itself.
+    get_target_property(sources ${target} SOURCES)
+    foreach(source IN LISTS sources)
+        get_filename_component(name "${source}" NAME_WE)
+        if(name MATCHES "^qrc_(.+)$")
+            string(REGEX REPLACE "[^A-Za-z0-9_]" "_" resource "${CMAKE_MATCH_1}")
+            get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
+            get_property(previous GLOBAL PROPERTY "KRITA_WASM_RESOURCE_SOURCE_${resource}")
+            if(previous AND NOT previous STREQUAL path)
+                message(FATAL_ERROR "Static resource name collision ${resource}: ${previous} and ${path}")
+            endif()
+            set_property(GLOBAL PROPERTY "KRITA_WASM_RESOURCE_SOURCE_${resource}" "${path}")
+            set_property(GLOBAL APPEND PROPERTY KRITA_WASM_RESOURCES "${resource}")
+        endif()
+    endforeach()
 endfunction()
 
 # Keep imports in an executable object so archive dead stripping cannot discard
@@ -55,6 +71,16 @@
         endif()
         string(APPEND imports "Q_IMPORT_PLUGIN(${factory})\n")
     endforeach()
+    get_property(resources GLOBAL PROPERTY KRITA_WASM_RESOURCES)
+    if(resources)
+        list(REMOVE_DUPLICATES resources)
+        list(SORT resources)
+        string(APPEND imports "\n#include <QResource>\nstatic void kritaWasmInitResources()\n{\n")
+        foreach(resource IN LISTS resources)
+            string(APPEND imports "    Q_INIT_RESOURCE(${resource});\n")
+        endforeach()
+        string(APPEND imports "}\nQ_CONSTRUCTOR_FUNCTION(kritaWasmInitResources)\n")
+    endif()
     set(source "${CMAKE_CURRENT_BINARY_DIR}/${target}_wasm_plugins.cpp")
     file(GENERATE OUTPUT "${source}" CONTENT "${imports}")
     target_sources(${target} PRIVATE "${source}")
