+QString browserFilePath(const QString &path)
+{
+    const QDir root(QString::fromUtf8(qgetenv("KRITA_WASM_FILES_DIR")));
+    QFileInfo info(path);
+    QStringList missing;
+    while (!info.exists() && !info.isSymLink()) {
+        missing.prepend(info.fileName());
+        const QString parent = info.absolutePath();
+        if (parent == info.absoluteFilePath())
+            return {};
+        info.setFile(parent);
+    }
+    QString physical = info.canonicalFilePath();
+    if (physical.isEmpty())
+        return {};
+    for (const QString &part : missing)
+        physical += QLatin1Char('/') + part;
+    const QString canonical = root.canonicalPath();
+    if (canonical.isEmpty())
+        return {};
+    if (physical == canonical)
+        return root.absolutePath();
+    if (physical.startsWith(canonical + QLatin1Char('/')))
+        return root.filePath(QDir(canonical).relativeFilePath(physical));
+    const QString virtualRoot =
+        QDir(QDir(QString::fromUtf8(qgetenv("KRITA_WASM_RECOVERY_DIR"))).absoluteFilePath(QStringLiteral("../virtual")))
+            .canonicalPath();
+    if (!virtualRoot.isEmpty() && (physical == virtualRoot || physical.startsWith(virtualRoot + QLatin1Char('/')))) {
+        // Resolve the visible alias from the filesystem, including a directory
+        // rename in this dialog. No cached JS/environment name is authoritative.
+        for (const auto &entry : root.entryInfoList(QDir::Dirs | QDir::Hidden | QDir::NoDotAndDotDot)) {
+            if (entry.isSymLink() && entry.canonicalFilePath() == virtualRoot)
+                return QDir::cleanPath(
+                    QDir(entry.absoluteFilePath()).filePath(QDir(virtualRoot).relativeFilePath(physical)));
+        }
+    }
+    return {};
+}
+
+class BrowserFilesModel : public QSortFilterProxyModel {
+  public:
+    explicit BrowserFilesModel(QObject *parent) : QSortFilterProxyModel(parent) {}
+
+  protected:
+    bool filterAcceptsRow(int row, const QModelIndex &parent) const override {
+        const QString path =
+            sourceModel()->index(row, 0, parent).data(QFileSystemModel::FilePathRole).toString();
+        if (!browserFilePath(path).isEmpty())
+            return true;
+        // QFileDialog still needs ancestor indexes to resolve its root index.
+        // Navigation and the visible location field never expose those roots.
+        const QString canonical =
+            QDir(QString::fromUtf8(qgetenv("KRITA_WASM_FILES_DIR"))).canonicalPath();
+        return !path.isEmpty() &&
+               (path == QLatin1String("/") || canonical.startsWith(path + QLatin1Char('/')));
+    }
+};
+} // namespace
+#endif
 
