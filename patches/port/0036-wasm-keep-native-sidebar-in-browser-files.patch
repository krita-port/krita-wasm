+void KisPreviewFileDialog::resetIconProvider() {
+#ifdef Q_OS_WASM
+    const QString root = QString::fromUtf8(qgetenv("KRITA_WASM_FILES_DIR"));
+    setProxyModel(new BrowserFilesModel(this));
+    // Qt's location combo builds a popup containing filesystem ancestors.
+    // Replace its visible field while retaining Qt's private widget internally.
+    auto *location = new QLineEdit(this);
+    location->setObjectName(QStringLiteral("browserDirectory"));
+    location->setReadOnly(true);
+    if (auto *combo = findChild<QComboBox *>(QStringLiteral("lookInCombo"))) {
+        delete layout()->replaceWidget(combo, location);
+        combo->hide();
+    }
+    const auto navigate = [this, root, location](const QString &path) {
+        const QString allowed = browserFilePath(path);
+        const QString target = allowed.isEmpty() ? root : allowed;
+        if (directory().absolutePath() != target)
+            setDirectory(target);
+        location->setText(target);
+        if (auto *up = findChild<QToolButton *>(QStringLiteral("toParentButton")))
+            up->setEnabled(target != root);
+        if (auto *up = findChild<QAction *>(QStringLiteral("qt_goto_parent_action")))
+            up->setEnabled(target != root);
+    };
+    setHistory({root});
+    connect(this, &QFileDialog::directoryEntered, this, navigate);
+    // Back/forward and programmatic navigation do not emit directoryEntered.
+    // Clamp after Qt finishes updating its view indexes, using the current
+    // directory rather than an older queued signal's destination.
+    auto *files = qobject_cast<QFileSystemModel *>(proxyModel()->sourceModel());
+    const auto persistBrowserChanges = [] {
+        EM_ASM({ globalThis.kritaRecovery.sync().catch(function() {}); });
+    };
+    connect(files, &QFileSystemModel::fileRenamed, this, persistBrowserChanges);
+    connect(files, &QAbstractItemModel::rowsRemoved, this, persistBrowserChanges);
+    connect(this, &QDialog::finished, this, persistBrowserChanges);
+    connect(files, &QFileSystemModel::rootPathChanged, this, [this, navigate] {
+        QTimer::singleShot(0, this, [this, navigate] {
+            navigate(directory().absolutePath());
+        });
+    });
+    navigate(directory().absolutePath());
+#endif
