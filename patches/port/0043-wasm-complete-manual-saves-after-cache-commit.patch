+#ifdef Q_OS_WASM
+    // A started background write is not a durable browser save. Keep all
+    // manual callers (including close/quit) waiting for the common completion.
+    QEventLoop saveLoop;
+    bool finished = false;
+    bool succeeded = false;
+    connect(this, &KisDocument::sigSavingFinished, &saveLoop, [&](const QString &path) {
+        if (path == job.filePath) {
+            finished = succeeded = true;
+            saveLoop.quit();
+        }
+    });
+    connect(this, &KisDocument::canceled, &saveLoop, [&] {
+        finished = true;
+        saveLoop.quit();
+    });
+#endif
