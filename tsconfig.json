{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "types": [
      "node",
      "emscripten"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "web/**/*.ts"
  ],
  "exclude": [
    "web/isolation-sw.ts"
  ]
}
